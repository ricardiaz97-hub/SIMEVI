{
  "rewrites": [
    {
      "source": "/api/login",
      "destination": "/api/auth?a=login"
    },
    {
      "source": "/api/logout",
      "destination": "/api/auth?a=logout"
    },
    {
      "source": "/api/google/:a(connect|callback|disconnect)",
      "destination": "/api/google?a=:a"
    },
    {
      "source": "/c/:t",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}